<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The app's ONLY network capability: one unauthenticated HTTPS GET to
      api.github.com on a cold start, to ask whether a newer TermChin release
      exists (see update/GitHubReleaseParser.kt). No other host, no analytics, no
      user data leaves the device — the app is otherwise fully offline. The APK is
      gated in CI: INTERNET is allowed, any OTHER permission is not.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CoursePlannerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
