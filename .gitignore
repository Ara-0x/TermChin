# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
# The whole local IDE config is machine-specific; never commit it.
.idea/

# Keystore files (never commit real keys; CI restores the release keystore from
# the RELEASE_KEYSTORE_BASE64 repository secret — see README "امضای بیلد و CI"
# and docs/SECURITY.md). The `git ls-files` gate in .github/workflows/build-apk.yml
# fails the build if any file matching these patterns is ever tracked again.
# The historical debug key that leaked here is retired: the current release
# certificate is documented in docs/SECURITY.md.
*.jks
*.keystore
*.base64
*.b64
debug.keystore
.ci-secrets/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
.vcs/

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
lint-results*.html
lint-results*.xml

# Android Profiling
*.hprof

# macOS
.DS_Store

# Windows
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*~

# Database files (optional, remove if you don't want to version control them)
*.db
*.db-journal

# Environment variables
.env
.env.local
.env.*.local

# Local CI release staging (APKs are published to GitHub Releases, not git)
release-output/

# Build folders (except what we want to commit)
*_public_key.*

# Local project backups (zip snapshots of the repo; source of truth is git)
backups/

# Local AI-agent / skill tooling (machine-specific, not part of the app)
.agents/
agent/
.claude/
skills-lock.json
skills_*.txt